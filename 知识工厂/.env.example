# 仅在知识工厂后端使用；复制为 .env 后填写，禁止提交真实密钥。
FACTORY_LLM_BASE_URL=https://api.deepseek.com
FACTORY_LLM_API_KEY=
FACTORY_LLM_MODEL=deepseek-v4-flash

# FastGPT OpenAPI 根地址、知识库 API Key 与目标知识库 ID。
FACTORY_FASTGPT_BASE_URL=http://127.0.0.1:3100/api
FACTORY_FASTGPT_API_KEY=
FACTORY_FASTGPT_DATASET_ID=

# Unified admin login. Generate the password hash with:
# python -m core.admin_auth
FACTORY_ADMIN_USERNAME=admin
FACTORY_ADMIN_PASSWORD_HASH=
FACTORY_SESSION_SECRET=
FACTORY_COOKIE_SECURE=false
FACTORY_COOKIE_PATH=/admin

# Local Liko operations summary. Use the same random token as backend ADMIN_API_TOKEN.
LIKO_API_BASE_URL=http://127.0.0.1:8001
LIKO_ADMIN_API_TOKEN=
FASTGPT_ADMIN_URL=http://127.0.0.1:3100
