APP_NAME=Liko API
APP_VERSION=0.1.0
ENVIRONMENT=development
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Only configure these on the backend. Never expose them to the H5.
FASTGPT_BASE_URL=
FASTGPT_API_KEY=
FASTGPT_APP_ID=
FASTGPT_TIMEOUT_SECONDS=60
# Optional: absolute path to 知识工厂/data/liko_style.json on the server.
LIKO_STYLE_FILE=
DATABASE_URL=
SESSION_SECRET=
SESSION_DAYS=30
GUEST_DAILY_LIMIT=10
USER_DAILY_LIMIT=50
# Local-only management summary token shared with the knowledge factory.
ADMIN_API_TOKEN=

# Pocket is an optional experiment. Production remains disabled by default.
POCKET_ENABLED=false
POCKET_LLM_BASE_URL=https://api.deepseek.com/v1
POCKET_LLM_API_KEY=
POCKET_LLM_MODEL=
POCKET_ASR_BASE_URL=
POCKET_ASR_API_KEY=
POCKET_ASR_MODEL=
POCKET_TIMEOUT_SECONDS=30

# Short-lived chat attachments. Raw files are processed in memory and are not retained.
ATTACHMENT_DIR=data/chat-attachments
ATTACHMENT_TTL_HOURS=24
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_TEXT_CHARS=16000
# Optional image understanding. If VISION_API_KEY is blank, the SiliconFlow embedding key below is reused.
VISION_ENABLED=false
VISION_BASE_URL=https://api.siliconflow.cn/v1
VISION_API_KEY=
VISION_MODEL=Qwen/Qwen3.6-35B-A3B
VISION_TIMEOUT_SECONDS=60

# Long-term memory is disabled until login and a separate application database are ready.
MEMORY_ENABLED=false
MEM0_LLM_PROVIDER=openai
MEM0_LLM_MODEL=deepseek-v4-flash
MEM0_LLM_BASE_URL=https://api.deepseek.com/v1
MEM0_LLM_API_KEY=
MEM0_EMBEDDER_PROVIDER=openai
MEM0_EMBEDDER_MODEL=BAAI/bge-m3
MEM0_EMBEDDER_BASE_URL=https://api.siliconflow.cn/v1
MEM0_EMBEDDER_API_KEY=
MEM0_EMBEDDING_DIMS=1024
MEM0_POSTGRES_URL=
MEM0_COLLECTION_NAME=liko_memories
MEM0_HISTORY_DB_PATH=data/mem0-history.db
MEM0_TOP_K=5
